# Go build output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go module cache / vendor
vendor/

# JSONL audit logs that handoff writes at runtime under
# %PROGRAMDATA%\whyknot\handoff\audit\. Never committed to the repo;
# the literal-anchor /audit/ matches the root only and leaves
# internal/audit/ (the source package) alone.
/audit/

# Temp unpacked tools
.handoff-bin/

# Bundled picotool binary downloaded by scripts/fetch-picotool.ps1.
# Embedded only into -tags embed_picotool builds; default builds use PATH.
internal/picotool/binaries/picotool.exe
version.txt

# Log files
*.log

# IDE
.idea/
.vscode/
*.swp
