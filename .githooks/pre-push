#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

root=$(git rev-parse --show-toplevel)
cd "${root}"
python -B .github/lint/style_check.py
bash .github/lint/repo_checks.sh
cargo fmt --check
timeout 1200 cargo clippy --workspace --all-targets --locked -- -D warnings
timeout 1200 cargo test --workspace --all-targets --locked
git ls-files -z -- '*.rs' | xargs -0 -r awk -f .github/lint/rust-style.awk
timeout 600 pwsh -NoProfile -File .github/lint/Invoke-PSLint.ps1
bash .github/lint/check-shell
